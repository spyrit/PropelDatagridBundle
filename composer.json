{
    "name": "spyrit/propel-datagrid-bundle",
    "description": "Symfony2 Datagrid Bundle for Propel.",
    "keywords": ["datagrid", "symfony", "propel"],
    "homepage": "https://github.com/spyrit/DatagridBundle.git",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Maxime Corson",
            "email": "maxime.corson@spyrit.net",
            "role": "Developer"
        },
        {
            "name": "Charles Henzel",
            "email": "charles.henzel@spyrit.net",
            "role": "Developer"
        },
        {
            "name": "Pierre-Yves Guerder",
            "email": "pierre-yves.guerder@spyrit.net",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "support@spyrit.net"
    },
    "require": {
        "php": ">=7.4.0",
        "symfony/symfony": "~4.0|~5.0|~6.0",
        "symfony/monolog-bundle": "~2.4|~3.0",
        "propel/propel": "^2.0@alpha|2.0.x-dev",
        "spyrit/colibri-csv": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpunit/php-code-coverage": "^9.2",
        "skyfox/propel-bundle": "^5.1|^6.0",
        "symfony/phpunit-bridge": "^7.1"
    },
    "autoload": {
        "psr-0": { "Spyrit\\PropelDatagridBundle": "" }
    },
    "target-dir": "Spyrit/PropelDatagridBundle",
    "repositories": [
      {
        "type": "git",
        "url": "https://github.com/SkyFoxvn/PropelBundle"
      }
    ]
